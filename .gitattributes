# Normalize text files to LF in the repository; Windows scripts keep CRLF in the working tree.
* text=auto
*.cmd  text eol=crlf
*.bat  text eol=crlf
*.ps1  text eol=crlf
*.sh   text eol=lf

# Patches are applied byte-exact by backend/scripts/build_extensions.cmd (git apply) - never convert them.
*.patch -text

*.png  binary
*.jpg  binary
*.webp binary
*.glb  binary
*.vxz  binary
