# Img3D backend configuration - copy to backend\.env and adjust.
# Real secrets live ONLY in backend\.env (gitignored). Never commit or log them.
# Relative paths are resolved against the backend directory (not the current working directory).
# Process environment variables override values from this file.

# ---------------------------------------------------------------- secrets (unprefixed)
# Hugging Face token - only needed to download the gated auxiliary models (DINOv3, RMBG-2.0).
HF_TOKEN=
# Optional single-user login for the web UI. Authentication turns on automatically when BOTH are set.
UI_USERNAME=
UI_PASSWORD=

# ---------------------------------------------------------------- application
# IMG3D_APP_NAME=Img3D
# development | production (production disables /api/docs)
# IMG3D_ENVIRONMENT=development
# IMG3D_HOST=127.0.0.1
# IMG3D_PORT=8000
# Comma-separated or JSON list
# IMG3D_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------- model / engine
# IMG3D_MODEL_DIR=.model/TRELLIS.2-4B
# IMG3D_AUX_MODEL_ROOT=.model
# IMG3D_TRELLIS_SOURCE_DIR=third_party/TRELLIS.2
# IMG3D_HF_HOME=.model/.hf_cache
# Auxiliary models only - TRELLIS.2-4B itself is never downloaded.
# IMG3D_ALLOW_MODEL_DOWNLOADS=true
# IMG3D_ENGINE=trellis2
# IMG3D_DEVICE=cuda
# IMG3D_LOW_VRAM=true
# auto | flash_attn | xformers | sdpa
# IMG3D_ATTENTION_BACKEND=auto
# Load the model at startup (the API is available immediately while it loads).
# IMG3D_PRELOAD_MODEL=true
# primary_only | multi_view (multi_view requires an engine that supports it)
# IMG3D_REFERENCE_MODE=primary_only
# Encode GLB textures as WEBP (EXT_texture_webp).
# IMG3D_GLB_WEBP_TEXTURES=true

# ---------------------------------------------------------------- storage / logging
# IMG3D_RUNTIME_DIR=runtime
# IMG3D_LOG_DIR=logs
# CRITICAL | ERROR | WARNING | INFO | DEBUG
# IMG3D_LOG_LEVEL=INFO
# JSON lines on the console instead of the human-readable format.
# IMG3D_LOG_JSON_CONSOLE=false

# ---------------------------------------------------------------- limits
# IMG3D_MAX_UPLOAD_MB=25
# IMG3D_MAX_IMAGE_PIXELS=64000000
# IMG3D_MIN_IMAGE_SIDE=64
# IMG3D_MAX_DETAIL_IMAGES=8
# IMG3D_MAX_QUEUE_SIZE=16
# IMG3D_JOB_RETENTION_DAYS=14
# IMG3D_MAX_STORED_JOBS=200
# IMG3D_REFERENCE_SET_RETENTION_DAYS=30

# ---------------------------------------------------------------- auth
# Unset = automatic (enabled iff UI_USERNAME and UI_PASSWORD are set); true/false forces it.
# IMG3D_AUTH_ENABLED=
# IMG3D_AUTH_TOKEN_TTL_HOURS=12
# Token signing secret. Unset = random per process (tokens become invalid after a restart).
# IMG3D_AUTH_SECRET=

# ---------------------------------------------------------------- serving / runtime tuning
# Built frontend served at "/" when it exists.
# IMG3D_FRONTEND_DIST_DIR=../frontend/dist
# IMG3D_SHUTDOWN_TIMEOUT_S=20
# WebSocket application-level ping interval (seconds).
# IMG3D_WS_PING_INTERVAL_S=20
# /system device info: timeout and cache (seconds).
# IMG3D_DEVICE_INFO_TIMEOUT_S=2
# IMG3D_DEVICE_INFO_CACHE_S=5
# Retention cleanup interval (seconds).
# IMG3D_RETENTION_INTERVAL_S=3600

# ---------------------------------------------------------------- Auto Mesh Tuner (Blender >= 5.1 runtime)
# Master switch for the Blender runtime + Auto Tune endpoints.
# IMG3D_BLENDER_ENABLED=true
# Administrator override: this blender.exe wins over detection when it is compatible.
# IMG3D_BLENDER_EXECUTABLE=C:\Program Files\Blender Foundation\Blender 5.2\blender.exe
# Extra folders to scan (each folder and its sub-folders' blender.exe). JSON list or ';'-separated.
# IMG3D_BLENDER_SEARCH_DIRS=D:\Tools\Blender;E:\Portable
# Minimum Blender version (X.Y or X.Y.Z).
# IMG3D_BLENDER_MIN_VERSION=5.1
# Managed runtime folder (selection, portable builds, resumable downloads). Unset = <runtime_dir>\blender.
# IMG3D_BLENDER_INSTALL_DIR=
# Allow downloading the official portable Blender (always after an explicit user confirmation).
# IMG3D_BLENDER_ALLOW_DOWNLOAD=true
# IMG3D_BLENDER_DOWNLOAD_BASE_URL=https://download.blender.org/release/
# latest = newest stable >= minimum | lts = newest LTS series
# IMG3D_BLENDER_DOWNLOAD_CHANNEL=latest
# Detect Blender installs in the background at startup (the API is available immediately).
# IMG3D_BLENDER_DETECT_ON_STARTUP=true
# Per-candidate `blender --version` probe timeout (seconds).
# IMG3D_BLENDER_DETECT_TIMEOUT_S=20
# Maximum duration of one Auto Tune run (seconds); the Blender process tree is killed afterwards.
# IMG3D_BLENDER_TUNE_TIMEOUT_S=1800
# Pending Auto Tune runs (429 when full).
# IMG3D_BLENDER_MAX_QUEUE_SIZE=4
